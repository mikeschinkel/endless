# OS
.DS_Store

# IDE
.idea/

# Python
__pycache__/
*.pyc
.venv/

# Go build output
/bin/

# SQLite binary DB (committed as .sql dump instead)
*.db
*.db-wal
*.db-shm

# Local git worktree checkouts created for parallel sessions
.endless/worktrees/

# Project-local scratch dir for agent-authored throwaway content (plans,
# outcomes) before it's loaded into the ledger. Sanctioned replacement for
# system /tmp: co-located with the work, survives reboot, and recoverable if a
# worktree is dropped before the content is loaded. `endless register` scaffolds
# this entry into every project's .gitignore.
.endless/tmp/

# Runtime logs (E-1917). session-notices.jsonl records every change notice the
# hook delivers to a session — a local observability aid for `tail -f` while
# working, not a project artifact. Per-machine and append-only; nothing here is
# reproducible or meaningful in another checkout.
.endless/logs/

# Per-worktree companion + ownership lock files (E-1218). Each worktree
# writes its own; main has no business carrying either, but if the
# SessionStart hook ever walks up from a cwd inside main and writes
# them, we don't want them tracked. Layer F's create_task_worktree
# also writes worktree.json into each new worktree's working tree.
.endless/worktree.json
.endless/worktree.lock

# Per-worktree isolated test environments (XDG_CONFIG_HOME target for manual sanity)
.test-isolated/

# Go workspace file generated by `just go-work-init` (E-996). Per-developer,
# absolute paths to local go-pkgs co-development checkouts.
go.work
go.work.sum

# Claude Code per-developer local settings (permission allow-rules, etc.).
# Bare basename, no leading slash, so it matches at any depth — covering both
# .claude/settings.local.json and demo/.claude/settings.local.json (and any
# future instances). settings.local.json is exclusively Claude's local-settings
# convention, so the broad match is safe in this repo.
settings.local.json

# The per-worktree Claude Code override (hooks from `just claude-settings-init`,
# the XDG_CONFIG_HOME env block from `endless sandbox bind`) is written to
# .claude/settings.local.json, so the settings.local.json rule above already
# covers it — nothing more is needed here.
#
# There is intentionally NO gitignore rule for .claude/settings.json: it is a
# tracked file (it carries enabledPlugins for everyone), and gitignore does not
# affect tracked files. Until E-1347 the override was written INTO that tracked
# file and hidden with `git update-index --skip-worktree`; that bit makes git
# refuse to check out any commit which CHANGES the file, so one commit to
# .claude/settings.json on main blocked the rebase in every live worktree at
# once. Endless no longer sets it, and never should again.

# Claude Code harness writes these per-session in .claude/ to track wakeups
# scheduled via the ScheduleWakeup tool. Transient, session-scoped, never
# meant for the repo. See https://github.com/anthropics/claude-code/issues/33565.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
